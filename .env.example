# Copy to .env to override the defaults used by docker-compose.yml.
# Every value below already has a development default; nothing is required to run locally.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch
POSTGRES_PORT=5432

# --- API ----------------------------------------------------------------------
BACKEND_PORT=8080
# HS256 signing key for access tokens. At least 32 bytes. CHANGE THIS outside local development.
DISPATCH_JWT_SECRET=dispatch-local-development-secret-change-me-0123456789
DISPATCH_JWT_TTL=12h
# Shared key event producers send in the X-API-Key header.
DISPATCH_INGEST_API_KEY=dispatch-dev-ingest-key
# Comma-separated browser origins allowed to call the API and open the WebSocket.
DISPATCH_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Load demo users, services, devices, rules, events and incidents on first start.
DISPATCH_SEED_ENABLED=true
# Development event simulator (endpoints and beans do not exist when disabled).
DISPATCH_SIMULATOR_ENABLED=true
DISPATCH_SIMULATOR_AUTO_START=true
DISPATCH_SIMULATOR_INTERVAL=3s

# --- Frontend -------------------------------------------------------------------
FRONTEND_PORT=3000
# Baked into the browser bundle at build time: how the *browser* reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
